POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_postgres_password
CORE_POSTGRES_DB=dcm_core_db
SSO_POSTGRES_DB=dcm_sso_db
JWT_SECRET=change_me_jwt_secret_at_least_32_chars
INTERNAL_SERVICE_TOKEN=change_me_internal_service_token_at_least_32_chars
SSO_ADMIN_USERNAME=admin
SSO_ADMIN_EMAIL=admin@example.local
SSO_ADMIN_PASSWORD=change_me_admin_password_at_least_6_chars
SSO_LOCAL_LOGIN_ENABLED=true
SSO_LOCAL_REGISTER_ENABLED=true
SSO_OIDC_ENABLED=false
SSO_OIDC_ISSUER_URL=http://keycloak.localhost/realms/dcm
SSO_OIDC_CLIENT_ID=dcm
SSO_OIDC_CLIENT_SECRET=change_me_keycloak_client_secret
SSO_OIDC_REDIRECT_URL=http://localhost/api/v1/auth/oidc/keycloak/callback
SSO_OIDC_ADMIN_GROUPS=/dcm-admins,dcm-admin
SSO_OIDC_DEFAULT_ROLE=user
KEYCLOAK_POSTGRES_USER=keycloak
KEYCLOAK_POSTGRES_PASSWORD=change_me_keycloak_postgres_password
KEYCLOAK_POSTGRES_DB=keycloak
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change_me_keycloak_admin_password
KEYCLOAK_HOSTNAME=http://keycloak.localhost
RABBITMQ_USER=dcm
RABBITMQ_PASSWORD=change_me_rabbitmq_password
MINIO_ROOT_USER=dcm_minio
MINIO_ROOT_PASSWORD=change_me_minio_password
OBJECT_STORAGE_ENDPOINT=minio:9000
OBJECT_STORAGE_BUCKET=dcm-builds
OBJECT_STORAGE_ACCESS_KEY=dcm_minio
OBJECT_STORAGE_SECRET_KEY=change_me_minio_password
OBJECT_STORAGE_USE_SSL=false
REGISTRY_API_URL=https://registry-backend:5000
REGISTRY_PUBLIC_URL=registry:5000
REGISTRY_URL=registry:5000
# Absolute directory containing CA, edge/backend TLS certificates and signing identity.
REGISTRY_CERTS_DIR=/etc/dcm/registry
REGISTRY_TOKEN_ISSUER=dcm-core
REGISTRY_HTTP_SECRET=change_me_registry_upload_state_secret
CLICKHOUSE_DB=dcm_reports
CLICKHOUSE_USER=dcm_reports
CLICKHOUSE_PASSWORD=change_me_clickhouse_password
CORE_HOST_DISK_PATH=/host
# Parent cgroup for user and build containers, for example dcm-tenants.slice.
# Empty keeps Docker's default. See docs/deployment-single-vm.md.
TENANT_CGROUP_PARENT=
DEFAULT_CPU_RESERVATION_MILLICORES=250
RESERVED_SYSTEM_CPU_MILLICORES=500
CPU_OVERCOMMIT_FACTOR=4
MAX_CPU_BURST_MULTIPLIER=4
CONTAINER_CPU_PERIOD=100000
IMAGE_BUILDS_ENABLED=true
BUILD_CANCEL_POLL_INTERVAL_SECONDS=2
REPORTS_USAGE_SNAPSHOT_INTERVAL_SECONDS=300
MAX_STAGED_SOURCE_BYTES_PER_USER=1073741824
MAX_QUEUED_BUILDS_PER_USER=10
CONTAINER_CREATE_WORKER_COUNT=2
CONTAINER_CREATE_MAX_ATTEMPTS=3
CONTAINER_CREATE_TIMEOUT_MINUTES=30
MAX_QUEUED_CONTAINER_CREATES_PER_USER=5
CONTAINER_CREATE_OUTBOX_INTERVAL_SECONDS=1
CONTAINER_CREATE_OUTBOX_BATCH_SIZE=10
MAX_QUEUED_COMPOSE_DEPLOYS_PER_USER=5
COMPOSE_COORDINATOR_INTERVAL_SECONDS=2
HOST_MIN_FREE_DISK_BYTES=1073741824
MEMORY_PRESSURE_MIN_FREE_BYTES=536870912
MEMORY_PRESSURE_INTERVAL_SECONDS=10
MEMORY_BOOST_MULTIPLIER=8
CPU_BOOST_MULTIPLIER=8
BOOST_MIN_FREE_MEMORY_BYTES=2147483648
DEFAULT_VOLUME_SIZE_BYTES=1073741824
VOLUME_SIZE_ENFORCEMENT=false
GIT_SOURCES_ENABLED=true
GIT_ALLOWED_HOSTS=github.com,gitlab.com,bitbucket.org
GIT_CLONE_TIMEOUT_SECONDS=60
GIT_MAX_REPOSITORY_BYTES=209715200
BUILDER_INSTANCE_ID=
DCM_HOST=localhost
BASE_DOMAIN=localhost
FRONTEND_API_URL=http://localhost/api/v1
TRAEFIK_DASHBOARD_ENABLED=false
TRAEFIK_LOG_LEVEL=INFO
# Future HTTPS/ACME settings; docker-compose.yml keeps HTTP-only defaults for now.
# TRAEFIK_ACME_EMAIL=admin@example.com
# TRAEFIK_ACME_STORAGE=/letsencrypt/acme.json
COMPOSE_LOG_MAX_SIZE=10m
COMPOSE_LOG_MAX_FILE=3
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:3000,http://localhost:5173
# Compose uses this same fixed Traefik IP for the Gateway trust list.
GATEWAY_INGRESS_SUBNET=172.30.251.0/24
TRAEFIK_GATEWAY_IP=172.30.251.2
# Standalone Gateway only: comma-separated proxy IPs/CIDRs; empty trusts none.
# Compose derives GATEWAY_TRUSTED_PROXIES from TRAEFIK_GATEWAY_IP instead.
GATEWAY_TRUSTED_PROXIES=
GATEWAY_MAX_JSON_BODY_BYTES=1048576
GATEWAY_AUTH_RATE_LIMIT_REQUESTS=20
GATEWAY_AUTH_RATE_LIMIT_WINDOW_SECONDS=60
GATEWAY_AUTH_REDIRECT_ALLOWED_ORIGINS=http://localhost,http://localhost:3000,http://localhost:5173
GATEWAY_AUTH_CALLBACK_PATH=/auth/callback
GATEWAY_UPLOAD_RATE_LIMIT_REQUESTS=10
GATEWAY_UPLOAD_RATE_LIMIT_WINDOW_SECONDS=60
GATEWAY_READ_HEADER_TIMEOUT_SECONDS=5
GATEWAY_READ_TIMEOUT_SECONDS=360
GATEWAY_WRITE_TIMEOUT_SECONDS=360
GATEWAY_IDLE_TIMEOUT_SECONDS=120
GATEWAY_SHUTDOWN_TIMEOUT_SECONDS=15
GATEWAY_MAX_HEADER_BYTES=1048576
GATEWAY_PROXY_DIAL_TIMEOUT_SECONDS=10
GATEWAY_PROXY_TLS_HANDSHAKE_TIMEOUT_SECONDS=10
GATEWAY_PROXY_RESPONSE_HEADER_TIMEOUT_SECONDS=60
GATEWAY_PROXY_IDLE_CONN_TIMEOUT_SECONDS=90
GATEWAY_PROXY_EXPECT_CONTINUE_TIMEOUT_SECONDS=1
GATEWAY_PROXY_MAX_IDLE_CONNS=100
GATEWAY_PROXY_MAX_IDLE_CONNS_PER_HOST=20
GATEWAY_GRPC_REQUEST_TIMEOUT_SECONDS=300
GATEWAY_GRPC_MIN_CONNECT_TIMEOUT_SECONDS=5
GATEWAY_GRPC_TLS_ENABLED=false
GATEWAY_GRPC_TLS_CA_FILE=
GATEWAY_GRPC_TLS_CERT_FILE=
GATEWAY_GRPC_TLS_KEY_FILE=
GATEWAY_GRPC_TLS_SERVER_NAME=
GATEWAY_READINESS_TIMEOUT_SECONDS=3
GATEWAY_TELEMETRY_TICKET_TTL_SECONDS=60
TELEMETRY_MAX_GLOBAL_LOG_STREAMS=100
TELEMETRY_MAX_GLOBAL_TERMINAL_SESSIONS=50
TELEMETRY_READ_HEADER_TIMEOUT_SECONDS=5
TELEMETRY_IDLE_TIMEOUT_SECONDS=120
TELEMETRY_SHUTDOWN_TIMEOUT_SECONDS=15
TELEMETRY_MAX_HEADER_BYTES=1048576
TELEMETRY_GRPC_REQUEST_TIMEOUT_SECONDS=10
TELEMETRY_GRPC_MIN_CONNECT_TIMEOUT_SECONDS=5
COOKIE_NAME=refresh_token
COOKIE_PATH=/
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_HTTP_ONLY=true
COOKIE_SAMESITE=lax

# PostgreSQL connection budgets (bootstrap only, per service).
# Core reserves one of MAX_OPEN for pinned advisory locks; minimum Core=2, SSO=1.
CORE_DB_MAX_OPEN=20
CORE_DB_MAX_LIFETIME=30m
CORE_DB_MAX_IDLE_TIME=5m
SSO_DB_MAX_OPEN=20
SSO_DB_MAX_LIFETIME=30m
SSO_DB_MAX_IDLE_TIME=5m
